---
import "../styles/global.css";
const { title = "My Astro Learning Journey" } = Astro.props;
import MobileMenu from "../components/MobileMenu.jsx";
import ThemeToggle from "../components/ThemeToggle.jsx";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="My journey learning Astro" />
  </head>

  <body>
    <header>
      <nav>
        <a href="/">My Astro Journey</a>

        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/learning">Learning</a>
          <a href="/blog">Blog</a>
          <a href="/about">About</a>

          <ThemeToggle client:load />
        </div>

        <MobileMenu client:load />
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>Built while learning Astro</p>
    </footer>
    <title>{title}</title>
  </body>
</html>